{
  "name": "xiaoziling-zhengzi-defense",
  "private": true,
  "version": "1.0.0",
  "description": "小字靈：正字保衛戰 —— 香港初小中文錯別字學習遊戲",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-hanzi-data.mjs && node scripts/embed-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-hanzi-data.mjs && node scripts/embed-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "build:single": "node scripts/copy-hanzi-data.mjs && node scripts/embed-assets.mjs --embed && tsc --noEmit && vite build --mode single && node scripts/embed-assets.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "framer-motion": "^11.11.0",
    "hanzi-writer": "^3.7.2",
    "hanzi-writer-data": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
